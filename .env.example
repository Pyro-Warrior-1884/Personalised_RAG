# Personalised RAG - example environment file.
# Copy to `.env.local` (or `.env`) and fill in your own values.
# `.env.local` takes precedence over `.env`.

# --- Required -------------------------------------------------------------
# API key from https://console.groq.com/keys
GROQ_API_KEY=replace_with_your_key
# Any model that is currently available in your Groq account.
GROQ_MODEL=openai/gpt-oss-20b

# --- Embeddings (local) ---------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DEVICE=cpu
# EMBEDDING_BATCH_SIZE=32

# --- Vector store ---------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_PREFIX=kb
# CHROMA_SPACE=cosine

# --- Sources --------------------------------------------------------------
# Where cloned GitHub repositories are stored.
REPOSITORY_WORKSPACE=./data/repositories
# Roots that may be indexed. Use ":" on macOS/Linux and ";" on Windows, or a
# JSON array such as ["/home/me/docs", "/srv/shared"].
ALLOWED_SOURCE_ROOTS=/home/you/Documents
# Ignore these directory names anywhere in the tree.
# IGNORED_DIRECTORIES=.git,node_modules,__pycache__,dist,build
# Files that must never be indexed.
# SENSITIVE_FILE_NAMES=.env,credentials,id_rsa
# SENSITIVE_FILE_EXTENSIONS=.pem,.key,.p12,.pfx
MAX_SOURCE_FILES=5000
MAX_FILE_SIZE_BYTES=26214400

# --- Chunking and retrieval ----------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_K=5
# Minimum cosine similarity for a chunk to count as evidence (0 disables it).
RETRIEVAL_SCORE_THRESHOLD=0.15

# --- Groq -----------------------------------------------------------------
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024
GROQ_REQUEST_TIMEOUT=60

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace_for_local_development
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
